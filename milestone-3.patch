+const fn resize_edge_coord(
+  rect: &Rect,
+  is_horizontal: bool,
+  is_prev_edge: bool,
+) -> i32 {
+  match (is_horizontal, is_prev_edge) {
+    (true, true) => rect.left,
+    (true, false) => rect.right,
+    (false, true) => rect.top,
+    (false, false) => rect.bottom,
+  }
+}
