+    (true, true) => curr_rect.left - visual_frame.left,
+    (true, false) => visual_frame.right - curr_rect.right,
+    (false, true) => curr_rect.top - visual_frame.top,
+    (false, false) => visual_frame.bottom - curr_rect.bottom,
+  }
