+  fn record_dragdrop_start(&mut self, root_id: isize) {
+    let seq = self.next_seq();
+    self.dragdrop_starts[self.dragdrop_idx] = (seq, root_id);
+    self.dragdrop_idx = (self.dragdrop_idx + 1) % CAPTURE_RING_LEN;
+  }
